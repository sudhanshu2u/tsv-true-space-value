# ── Gemini AI (required) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ── Upstash Redis (recommended — stores TSV reports persistently) ─
# Without this, reports are stored in local /data/ files and lost on redeploy.
# Free tier at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
